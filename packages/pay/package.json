{
	"name": "@agentaos/pay",
	"version": "2.4.0",
	"description": "AgentaOS TypeScript SDK: sell digital products with a merchant of record that takes the payment, charges the VAT, issues the invoice and pays you out",
	"license": "Apache-2.0",
	"keywords": [
		"payments",
		"merchant-of-record",
		"billing",
		"subscriptions",
		"invoices",
		"checkout",
		"vat",
		"discount-codes",
		"webhooks",
		"sdk",
		"typescript"
	],
	"author": "AgentaOS <hello@agentaos.ai>",
	"repository": {
		"type": "git",
		"url": "https://github.com/AgentaOS/agentaos.git",
		"directory": "packages/pay"
	},
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"files": ["dist"],
	"engines": {
		"node": ">=20.0.0"
	},
	"publishConfig": {
		"access": "public"
	},
	"devDependencies": {
		"@types/node": "^20.0.0"
	},
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"lint": "biome check src/",
		"test": "vitest run --passWithNoTests",
		"typecheck": "tsc --noEmit",
		"clean": "rm -rf dist"
	}
}
