{
	"name": "@agentaos/better-auth",
	"version": "1.0.0",
	"description": "Better Auth plugin for AgentaOS, the merchant of record: checkouts for signed-in users, their subscriptions, and verified webhooks",
	"homepage": "https://docs.agentaos.ai/sdk/pay-overview",
	"license": "Apache-2.0",
	"keywords": [
		"better-auth",
		"better-auth-plugin",
		"payments",
		"merchant-of-record",
		"subscriptions",
		"checkout",
		"billing",
		"agentaos"
	],
	"author": "AgentaOS <contact@agentaos.ai>",
	"repository": {
		"type": "git",
		"url": "https://github.com/AgentaOS/agentaos.git",
		"directory": "packages/better-auth"
	},
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./client": {
			"types": "./dist/client.d.ts",
			"import": "./dist/client.js"
		}
	},
	"files": ["dist"],
	"sideEffects": false,
	"publishConfig": {
		"access": "public"
	},
	"dependencies": {
		"@agentaos/pay": "workspace:^"
	},
	"peerDependencies": {
		"better-auth": "^1.3.0",
		"zod": "^3.25.0 || ^4.0.0"
	},
	"devDependencies": {
		"better-auth": "1.7.7",
		"zod": "4.6.5"
	},
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"lint": "biome check src/",
		"test": "vitest run",
		"typecheck": "tsc --noEmit",
		"clean": "rm -rf dist"
	}
}
