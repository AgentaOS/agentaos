{
	"name": "agentaos",
	"version": "3.2.1",
	"description": "AgentaOS CLI (agenta) and MCP server: set up billing, subscriptions, discount codes and invoices with a merchant of record, from your terminal or your AI coding agent",
	"license": "Apache-2.0",
	"author": "AgentaOS <hello@agentaos.ai>",
	"repository": {
		"type": "git",
		"url": "https://github.com/AgentaOS/agentaos.git",
		"directory": "packages/wallet"
	},
	"homepage": "https://github.com/AgentaOS/agentaos",
	"bugs": "https://github.com/AgentaOS/agentaos/issues",
	"keywords": [
		"payments",
		"merchant-of-record",
		"billing",
		"subscriptions",
		"invoices",
		"checkout",
		"vat",
		"cli",
		"mcp",
		"ai-agents"
	],
	"type": "module",
	"bin": {
		"agentaos": "./dist/index.js",
		"agenta": "./dist/index.js"
	},
	"exports": {
		"./mcp": {
			"types": "./dist/mcp/tools/index.d.ts",
			"default": "./dist/mcp/tools/index.js"
		}
	},
	"files": ["dist", "!dist/__tests__"],
	"engines": {
		"node": ">=20.0.0"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"dev": "tsx src/index.ts",
		"lint": "biome check src/",
		"test": "vitest run --passWithNoTests",
		"typecheck": "tsc --noEmit",
		"clean": "rm -rf dist"
	},
	"dependencies": {
		"@agentaos/pay": "workspace:^",
		"@modelcontextprotocol/sdk": "^1.12.0",
		"chalk": "^5.3.0",
		"commander": "^12.1.0",
		"ora": "^8.1.0",
		"zod": "^3.24.0"
	},
	"devDependencies": {
		"@types/node": "^20.0.0",
		"tsx": "^4.19.0"
	}
}
