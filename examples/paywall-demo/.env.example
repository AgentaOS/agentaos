# Test key from the dashboard: Settings, Developers, Generate Test Key. Server only.
AGENTAOS_API_KEY=sk_test_replace_me

# Leave unset to use https://api.agentaos.ai. Set it only to point at another API.
# AGENTAOS_API_URL=

# The plan's link ID: on the plan's page, open "Building this into your site?" and click Copy ID.
PRO_LINK_ID=
# Optional second plan (same currency and billing interval) for the upgrade button.
PRO_PLUS_LINK_ID=

# The dashboard's webhook signing secret (Settings, Developers, Webhooks, Reveal signing secret).
# For a local test with `pnpm webhook:test`, any value works: the script signs with this same value.
AGENTAOS_WEBHOOK_SECRET=whsec_replace_me

# Where the app runs. Checkout only accepts an https return address, so run locally
# on https://127.0.0.1 with the certificate from `pnpm cert`.
APP_URL=https://127.0.0.1:4567
PORT=4567
TLS_CERT=certs/cert.pem
TLS_KEY=certs/key.pem
