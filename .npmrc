# Supply-chain hygiene: refuse package versions younger than 7 days (10080 min).
# Stops "publish-and-yank" attacks where a hijacked maintainer ships a malicious
# release that gets caught + retracted within hours. By forcing a cooldown window
# we never install versions that haven't had time to be vetted by the community.
#
# Requires pnpm 10.0+ — silently ignored on 9.x (packageManager pins 10.33.3).
minimum-release-age=10080
